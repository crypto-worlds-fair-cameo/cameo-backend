{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "npm run build && npm run start:prod",
    "start:dev": "nodemon --watch src --watch tsconfig.json --watch tsconfig.build.json --ext ts,json --exec \"npm start\"",
    "start:debug": "nodemon --watch src --watch tsconfig.json --watch tsconfig.build.json --ext ts,json --exec \"npm run build && node --enable-source-maps --inspect dist/main.js\"",
    "start:prod": "node --enable-source-maps dist/main.js",
    "lint": "oxlint --deny-warnings src",
    "typecheck": "tsc --noEmit --incremental false",
    "lint:fix": "oxlint --fix src",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@noble/curves": "1.9.7",
    "@solana/wallet-standard-util": "1.1.4",
    "bs58": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "nodemon": "3.1.14",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "tsc-alias": "1.9.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
