{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run build && npm run start:prod",
    "start:dev": "nodemon --watch src --watch tsconfig.json --watch tsconfig.build.json --ext ts,json --exec \"npm start\"",
    "start:debug": "nodemon --watch src --watch tsconfig.json --watch tsconfig.build.json --ext ts,json --exec \"npm run build && node --enable-source-maps --inspect dist/main.js\"",
    "start:prod": "node --enable-source-maps dist/main.js",
    "lint": "oxlint --deny-warnings src test",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.cjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint:fix": "oxlint --fix src test",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:db": "npm run build && node test/postgres.integration.cjs"
  },
  "dependencies": {
    "@nestjs/axios": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "axios": "1.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.1",
    "nodemon": "3.1.14",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsc-alias": "1.9.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
