APP_NAME='Nest React Boilerplate'
APP_VERSION='0.0.1'
NODE_ENV='development'
HOST='127.0.0.1'
PORT=5000
# Leave empty when using a dedicated API subdomain such as api.example.com.
API_PREFIX='api'

CORS_ORIGIN_LIST='http://localhost:5173'
CORS_ALLOWED_HEADERS='Content-Type,Authorization,X-Request-Id'
CORS_METHODS='GET,POST,PUT,PATCH,DELETE,OPTIONS'
CORS_CREDENTIALS='true'

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

DB_HOST='localhost'
DB_PORT=5432
DB_USER='dev'
DB_PASSWORD='replace-with-your-db-password'
DB_NAME='devdb'
DB_POOL_MAX=10

# Trust only this many reverse-proxy hops; 0 disables forwarded IP trust.
TRUST_PROXY_HOPS=0
# TLS verifies the server certificate; optionally supply the provider CA as PEM.
DB_SSL=false
DB_SSL_CA=''
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

CANVAS_SNAPSHOT_ENABLED=false
CANVAS_SNAPSHOT_STORAGE_ROOT=
CANVAS_SNAPSHOT_PUBLIC_BASE_URL=
CANVAS_SNAPSHOT_INTERVAL_SECONDS=3600
CANVAS_SNAPSHOT_DISK_BUDGET_BYTES=21474836480
CANVAS_SNAPSHOT_MIN_FREE_BYTES=5368709120

SEASON_NFT_ENABLED=false
SOLANA_NETWORK=
SOLANA_RPC_URL=
SOLANA_SERVICE_KEYPAIR_PATH=
NFT_STORAGE_UPLOAD_URL=
NFT_STORAGE_PAYMENT_URL=
NFT_STORAGE_GATEWAY_URL=
NFT_UPLOAD_WORK_DIR=
NFT_PREPARATION_KEY_DIR=
SEASON_NFT_PERSISTENCE_EVIDENCE_PATH=
SEASON_NFT_SDK_EVIDENCE_PATH=
NFT_RPC_READ_RPS=5
NFT_RPC_SEND_INTERVAL_MS=1200
NFT_PRIORITY_FEE_MAX_LAMPORTS=0
